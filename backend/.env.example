PORT=3002

# mock | watsonx | gemini | local — whichever is set here is tried FIRST;
# the other real providers are tried automatically as fallbacks, in a fixed
# order ending with `local`, before ever dropping to the generic mock story.
# Set to watsonx to maximize real IBM usage by default. `local` (see below)
# needs no key or account at all and can never run out of quota, so it's
# always included as the last real rung even if you don't set it as primary.
VISION_PROVIDER=mock

# Only needed when VISION_PROVIDER=watsonx
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Vision model: Granite Vision isn't available on all watsonx accounts/plans
# (confirmed unavailable on Lite in every region as of 2026-07) — this is the
# vision-capable model actually available; swap back to a Granite Vision
# model_id if/when your account has access to one.
WATSONX_MODEL_ID=meta-llama/llama-3-2-11b-vision-instruct
WATSONX_TEXT_MODEL_ID=ibm/granite-3-8b-instruct

# Only needed when VISION_PROVIDER=gemini — a non-IBM stand-in for when
# watsonx's Lite-plan token quota (300k/month) runs out. Google's free
# text/vision-understanding tier (NOT image generation, which needs
# billing) — get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# mock | watson | local
TTS_PROVIDER=mock

# Only needed when TTS_PROVIDER=watson
TTS_API_KEY=
TTS_URL=https://api.us-south.text-to-speech.watson.cloud.ibm.com/instances/<instance-id>

# Local, zero-cost, zero-quota provider for vision/text (via Ollama) and TTS
# (via macOS's built-in `say`) — used when VISION_PROVIDER=local or as the
# automatic last-resort fallback rung of every cascade regardless of what's
# set as primary. Needs no API key, no billing, no account, and can never
# run out of quota — unlike watsonx's 300k/month or Gemini's 20/day free-tier
# caps, both of which got fully exhausted at least once during development.
# Setup: `brew install ollama && brew services start ollama`, then
# `ollama pull llava` (vision) and `ollama pull llama3.2:3b` (text).
# Local TTS only works on macOS (uses the `say` command); local vision/text
# works anywhere Ollama runs. Honest tradeoff: both local models are far
# weaker and much slower than the cloud providers — llava takes ~60-90s per
# comic page (vs. a few seconds for watsonx/Gemini) to reliably return valid
# structured JSON; a smaller/faster vision model (moondream, ~1.7GB) was
# tried first and reliably returned malformed or empty output on the full
# schema — too weak for this task, so llava (~4.7GB) is the default despite
# being slower. Similarly, llama3.2:1b readily fabricated unstated backstory
# on Emotion Lens's grounded-Q&A task where llama3.2:3b consistently hedged
# instead — worth the extra size for the one task where honesty matters
# most. Override the model names with LOCAL_VISION_MODEL / LOCAL_TEXT_MODEL
# / OLLAMA_URL if needed.
# LOCAL_VISION_MODEL=llava
# LOCAL_TEXT_MODEL=llama3.2:3b
# OLLAMA_URL=http://localhost:11434

# mock | huggingface — Synesthesia Studio's image generation.
# Non-IBM by necessity: watsonx has no image-generation model at all
# (confirmed, not a Lite-plan limitation). Genuinely free, no card required —
# get a token (with "Make calls to Inference Providers" permission) at
# https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
IMAGE_PROVIDER=mock
HF_API_KEY=
